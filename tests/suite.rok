use pkg::{render, render_untrusted, slug, Options};

fn html_of(src: str) -> str { render(src).html }

fn expect(ok: bool, what: str) {
    if !ok { panic(f"check failed: {what}"); }
}

#[test]
fn renders_blocks() {
    expect(html_of("# A `b`\n\ntext *em* **st**\n") == "<h1 id=\"a-b\"><a class=\"anchor\" href=\"#a-b\" aria-hidden=\"true\">#</a>A <code>b</code></h1>\n<p>text <em>em</em> <strong>st</strong></p>\n", "case 1");
    expect(html_of("- a\n  - b\n- c\n") == "<ul>\n<li>a\n<ul>\n<li>b\n</li>\n</ul>\n</li>\n<li>c\n</li>\n</ul>\n", "case 2");
    expect(html_of("| x | y |\n|---|:-:|\n| 1 | 2 |\n").contains("<td style=\"text-align:center\">2</td>"), "case 3");
    expect(html_of("> [!NOTE]\n> hi\n") == "<div class=\"callout note\"><p class=\"callout-title\">Note</p>\n<p>hi</p>\n</div>\n", "case 4");
    expect(html_of("3. a\n\n   b\n4. c\n") == "<ol start=\"3\">\n<li><p>a</p>\n<p>b</p>\n</li>\n<li><p>c</p>\n</li>\n</ol>\n", "loose ordered");
    expect(html_of("<div class=\"x\">\n*a*\n</div>\n") == "<div class=\"x\">\n*a*\n</div>\n", "html block");
}

#[test]
fn code_blocks() {
    let src = "```rok x\na < b\n```\n\n```\nplain\n```\n";
    expect(html_of(src) == "<pre><code class=\"language-rok\">a &lt; b\n</code></pre>\n<pre><code>plain\n</code></pre>\n", "default");
    let h = render(src, Options { code: |lang, code| if lang == "rok" { f"[{code.trim()}]" } else { none } }).html;
    expect(h == "<pre><code class=\"language-rok\">[a < b]</code></pre>\n<pre><code>plain\n</code></pre>\n", "callback");
}

#[test]
fn headings_and_footnotes() {
    let d = render("# T\n\n## a\n\n## a\n\nx[^1]\n\n[^1]: note\n");
    expect(d.title == "T" && d.headings.len() == 3 && d.headings[2].id == "a-1", "ids");
    expect(d.html.contains("<sup class=\"fnref\"><a href=\"#fn-1\">1</a></sup>"), "ref");
    expect(d.html.contains("<p class=\"footnote\" id=\"fn-1\"><sup>1</sup> note</p>"), "def");
}

#[test]
fn renders_inlines() {
    expect(html_of("snake_case_name and i*, u*") == "<p>snake_case_name and i*, u*</p>\n", "case 6");
    expect(html_of("[a `b`](x.md#y) <https://e.org> a < b & c &lt;") == "<p><a href=\"x.md#y\">a <code>b</code></a> <a href=\"https://e.org\">https://e.org</a> a &lt; b &amp; c &lt;</p>\n", "case 7");
    expect(html_of("[outer [in](a) x](b)") == "<p>[outer <a href=\"a\">in</a> x](b)</p>\n", "case 8");
    expect(html_of("~~d~~ ![i *a*](p.png \"t\")\\\nx") == "<p><del>d</del> <img src=\"p.png\" alt=\"i a\"><br>\nx</p>\n", "del img br");
    let h = render("[a](x.md)", Options { link: |d| d.replace(".md", ".html") }).html;
    expect(h == "<p><a href=\"x.html\">a</a></p>\n", "link map");
}

#[test]
fn github_slugs() {
    expect(slug("3.14.10. ? 연산자 \u{2014} none 조기 반환") == "31410--연산자--none-조기-반환", "case 9");
    expect(slug("점 / 물음표") == "점--물음표", "case 10");
}

#[test]
fn untrusted() {
    let h = render_untrusted("<div onclick=\"x()\">\n<script>bad()</script>\n</div>\n").html;
    expect(!h.contains("<div") && !h.contains("<script"), "case 11");
    let l = render_untrusted("[a](javascript:alert(1)) [b](JavaScript:x) ![c](data:x) [d](https://e.org) [e](a/b:c) [f](#x)").html;
    expect(l == "<p><a href=\"#\">a</a> <a href=\"#\">b</a> <img src=\"#\" alt=\"c\"> <a href=\"https://e.org\">d</a> <a href=\"a/b:c\">e</a> <a href=\"#x\">f</a></p>\n", l);
    let c = render_untrusted("> [!<img src=x onerror=y>]\n> z\n").html;
    expect(!c.contains("<img"), "callout label");
}

#[test]
fn callout_labels() {
    let h = render("> [!TIP]\n> x\n", Options { callout: |k| if k == "tip" { "팁" } else { k } }).html;
    expect(h.contains("<p class=\"callout-title\">팁</p>"), "custom");
}
